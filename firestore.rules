rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shape-validated public order inquiries from the Contact Us form. Locks
    // down everything that could let a public submission masquerade as a
    // further-along/paid order, and caps text/photo-array sizes as basic
    // spam mitigation. Reading, updating, and deleting orders still always
    // requires being signed in as the shop owner (below).
    function isValidPublicInquiry(data) {
      return data.keys().hasOnly([
          'customerName', 'contactMethod', 'contactInfo', 'orderPlacedDate',
          'ideaDescription', 'referencePhotos', 'size', 'payments', 'totalPrice',
          'status', 'dueDate', 'notes', 'progressPhotos', 'pickupPreference',
          'shippingZip', 'createdAt'
        ])
        && data.contactMethod == 'Website'
        && data.status == 'New Inquiry'
        && data.payments.size() == 0
        && data.progressPhotos.size() == 0
        && data.dueDate == ''
        && data.notes == ''
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 200
        && data.contactInfo is string && data.contactInfo.size() > 0 && data.contactInfo.size() < 300
        && data.ideaDescription is string && data.ideaDescription.size() < 3000
        && data.referencePhotos is list && data.referencePhotos.size() < 10
        && data.pickupPreference in ['Pick Up in San Antonio', 'Ship']
        && data.shippingZip is string && data.shippingZip.size() < 12
        && data.createdAt is number;
    }
    match /orders/{orderId} {
      allow read, update, delete: if request.auth != null
        && request.auth.token.email in ['wong.amaymay@gmail.com', 'floressart92@gmail.com'];
      allow create: if (request.auth != null
          && request.auth.token.email in ['wong.amaymay@gmail.com', 'floressart92@gmail.com'])
        || isValidPublicInquiry(request.resource.data);
    }
    // Public read-only access for the customer-facing shop page (For Sale +
    // Previously Sold sections). Writes still require being signed in below.
    match /forSale/{itemId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['wong.amaymay@gmail.com', 'floressart92@gmail.com'];
    }
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['wong.amaymay@gmail.com', 'floressart92@gmail.com'];
    }
    // Public read-only aggregate order-queue count for the Contact Us page.
    // Contains nothing but a number — no customer order data is ever
    // publicly readable.
    match /queueStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['wong.amaymay@gmail.com', 'floressart92@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['wong.amaymay@gmail.com', 'floressart92@gmail.com'];
    }
  }
}
